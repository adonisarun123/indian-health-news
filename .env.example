# Neon pooled connection (web and worker). Use sslmode=verify-full.
DATABASE_URL=
# Neon direct connection (migrations and seed)
DATABASE_URL_DIRECT=
# 32 random bytes, base64. Encrypts producer HMAC secrets at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INGEST_SECRET_KEY=
SITE_NAME=India Health News

# Fixture producer (printed by `npm run db:seed -- --demo`)
INGEST_BASE_URL=http://localhost:3000
PRODUCER_KEY=
PRODUCER_SECRET=

# Test suite: any Postgres 16+ superuser URL. `npm run test:db` starts one on 5433.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
